<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hermod server (~/.herald/server/app.py): the channel API on 127.0.0.1:3026.
     Installed as ~/Library/LaunchAgents/com.herald.server.plist by ~/.herald/bin/install-launchd. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.herald.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/anzes/.herald/.venv/bin/python</string>
		<string>/Users/anzes/.herald/server/app.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/anzes/.herald</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<!-- launchd hands a bare PATH; the GitHub poller shells out to `gh` (the same PATH as com.jarvis.daemon). -->
		<key>PATH</key>
		<string>/Users/anzes/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/anzes/.herald/state/logs/server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/anzes/.herald/state/logs/server.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
